# Copie para as variáveis de ambiente do Coolify (não coloque valores reais neste arquivo).

# Chave da conta Asaas (Minha Conta > Integrações > Chave de API)
ASAAS_API_KEY=

# "sandbox" para testes; deixe vazio em produção
ASAAS_AMBIENTE=sandbox

# Um texto secreto qualquer; use o MESMO ao criar o webhook no painel do Asaas
ASAAS_WEBHOOK_TOKEN=

# Endereço público do site, sem barra no final (ex.: https://maisonlouree.com.br)
SITE_URL=

# Frete fixo em reais (ex.: 25.00). Vazio = frete a combinar
FRETE_VALOR=
